#!/usr/bin/env bash
# bin/sitegraft — entrypoint. Dispatches to a phase implemented in lib/<phase>.sh.
set -euo pipefail

SITEGRAFT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/core.sh
. "${SITEGRAFT_ROOT}/lib/core.sh"

# Installed HERE, not as a side effect of sourcing lib/core.sh above —
# verified live, a real bug fixed in the review fix-pack: a trap installed
# at a library's source time clobbers whatever EXIT trap the caller already
# had, which for `bats` is its own per-test pass/fail machinery. Every
# unit test `load`s lib/core.sh directly; a version that self-installed the
# trap there made a genuinely FAILING bats test come out as
# "Executed 0 instead of expected 1 tests" with no `not ok` line at all —
# invisible, not merely unclear.
trap sitegraft_cleanup EXIT

SITEGRAFT_VERSION="0.5.1"

usage() {
  cat <<EOF
sitegraft ${SITEGRAFT_VERSION}

Usage: sitegraft <phase> --profile <name> [flags]

Phases: scan, plan, backup, graft, verify, restore

EOF
}

# require_lib <name> <step> — source lib/<name>.sh, or fail with a clear
# "not implemented yet" message instead of the raw ". : No such file or
# directory" bash error a missing later-step lib file would otherwise
# produce (m6 — plan/backup/graft/verify/restore aren't implemented until
# later steps of docs/plans/2026-08-19-sitegraft-implementation.md).
require_lib() {
  local lib="$1" step="$2"
  local path="${SITEGRAFT_ROOT}/lib/${lib}.sh"
  if [ ! -f "$path" ]; then
    log_error "phase not implemented yet — lib/${lib}.sh does not exist (see Step ${step} of docs/plans/2026-08-19-sitegraft-implementation.md)"
    return 1
  fi
  # shellcheck disable=SC1090
  . "$path"
}

main() {
  local phase="${1:-}"
  [ -n "$phase" ] || { usage; exit 1; }
  shift || true

  # m5: dependencies are checked per phase, not all up front — "sitegraft
  # --help"/"-h" (and, previously, every phase) used to require rsync even
  # though only backup/graft/restore actually invoke it.
  case "$phase" in
    scan)
      require_cmd jq || exit 1
      require_lib profile 1 || exit 1
      require_lib modules 1 || exit 1
      require_lib inventory 1 || exit 1
      modules_discover
      phase_scan "$@"
      ;;
    plan)
      require_cmd jq || exit 1
      require_lib profile 1 || exit 1
      require_lib modules 1 || exit 1
      require_lib inventory 1 || exit 1
      require_lib manifest 2 || exit 1
      require_lib plan 2 || exit 1
      modules_discover
      phase_plan "$@"
      ;;
    backup)
      require_cmd jq || exit 1
      require_cmd rsync || exit 1
      require_cmd gzip || exit 1
      require_cmd shasum || exit 1
      require_lib profile 1 || exit 1
      require_lib inventory 1 || exit 1
      require_lib backup 3 || exit 1
      phase_backup "$@"
      ;;
    graft)
      require_cmd jq || exit 1
      require_cmd rsync || exit 1
      require_lib profile 1 || exit 1
      require_lib modules 1 || exit 1
      require_lib inventory 1 || exit 1
      # graft.sh reuses backup.sh's _backup_local_exec_prefix for every local
      # (non-ssh) transfer that touches a wrapped-local site (e.g. DDEV) — see
      # lib/graft.sh's own header comment for why.
      require_lib backup 3 || exit 1
      require_lib graft 4 || exit 1
      modules_discover
      phase_graft "$@"
      ;;
    verify)
      require_cmd jq || exit 1
      require_lib profile 1 || exit 1
      require_lib inventory 1 || exit 1
      require_lib backup 3 || exit 1
      require_lib graft 4 || exit 1
      require_lib verify 5 || exit 1
      phase_verify "$@"
      ;;
    restore)
      require_cmd jq || exit 1
      require_cmd rsync || exit 1
      require_cmd gzip || exit 1
      require_lib profile 1 || exit 1
      require_lib backup 3 || exit 1
      phase_restore "$@"
      ;;
    -h|--help|help) usage ;;
    --version) echo "sitegraft ${SITEGRAFT_VERSION}" ;;
    *) log_error "unknown phase: ${phase}"; usage; exit 1 ;;
  esac
}

main "$@"
