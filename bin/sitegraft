#!/usr/bin/env bash
# bin/sitegraft — entrypoint. Dispatches to a phase implemented in lib/<phase>.sh.
set -euo pipefail

SITEGRAFT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/core.sh
. "${SITEGRAFT_ROOT}/lib/core.sh"

# Installed HERE, not as a side effect of sourcing lib/core.sh above —
# verified live, a real bug fixed in the review fix-pack: a trap installed
# at a library's source time clobbers whatever EXIT trap the caller already
# had, which for `bats` is its own per-test pass/fail machinery. Every
# unit test `load`s lib/core.sh directly; a version that self-installed the
# trap there made a genuinely FAILING bats test come out as
# "Executed 0 instead of expected 1 tests" with no `not ok` line at all —
# invisible, not merely unclear.
trap sitegraft_cleanup EXIT

SITEGRAFT_VERSION="1.0.0-rc11"

usage() {
  cat <<EOF
sitegraft ${SITEGRAFT_VERSION}

Usage: sitegraft <phase> --profile <name> [flags]

Phases: scan, plan, backup, graft, verify, restore

EOF
}

# require_lib <name> <step> — source lib/<name>.sh, or fail with a clear
# "not implemented yet" message instead of the raw ". : No such file or
# directory" bash error a missing later-step lib file would otherwise
# produce (m6 — plan/backup/graft/verify/restore aren't implemented until
# later steps of docs/plans/2026-08-19-sitegraft-implementation.md).
require_lib() {
  local lib="$1" step="$2"
  local path="${SITEGRAFT_ROOT}/lib/${lib}.sh"
  if [ ! -f "$path" ]; then
    log_error "phase not implemented yet — lib/${lib}.sh does not exist (see Step ${step} of docs/plans/2026-08-19-sitegraft-implementation.md)"
    return 1
  fi
  # shellcheck disable=SC1090
  . "$path"
}

main() {
  # Task 6.1 Step 1: global --dry-run handling, applied to the WHOLE argv
  # uniformly, before the phase name is even read out of it. This is
  # deliberately NOT the only place --dry-run gets parsed — every phase
  # function below (phase_scan, phase_backup, phase_graft, phase_verify,
  # phase_restore) also parses its own --dry-run flag independently (see
  # each lib/*.sh's own case statement), because every one of them is also
  # called DIRECTLY by the bats unit tests, bypassing bin/sitegraft entirely
  # — removing the per-phase parsing would break that. What this adds is
  # CLI-level consistency for the actual `sitegraft` command: without it,
  # `plan` (which never writes to B, so never needed its own --dry-run case)
  # would reject `--dry-run` as an "unknown flag" while every writing phase
  # accepts it silently — an operator adopting the habit "always pass
  # --dry-run first" would hit a confusing, inconsistent error on exactly
  # one phase. With this, `--dry-run` is uniformly a safe, accepted no-op on
  # phases that don't need it (scan/plan/verify), same as it already was via
  # each phase's own env-var-or-flag handling. A plain indexed bash array is
  # fine here despite the bash 3.2 target (ADR 0003, docs/decisions/
  # 0003-bash-compatibility.md) — that decision rules out ASSOCIATIVE arrays
  # only (`declare -A`, bash 4+); ordinary indexed arrays like this one have
  # always worked on bash 3.2.
  #
  # NIT-D fix (review fix-pack): stripped from "$@" HERE, before `phase` is
  # read below, not after — `sitegraft --dry-run graft --profile x` (flag
  # BEFORE the phase name, a completely reasonable thing to type) used to
  # read "--dry-run" itself as the phase, since the stripping loop only ran
  # AFTER `local phase="${1:-}"` had already captured it, and failed with
  # the confusing "unknown phase: --dry-run" instead of being accepted the
  # same as everywhere else in the argv.
  #
  # BUG found live (reproduced with a plain `sitegraft --help` call --
  # nothing to do with --dry-run at all): "${args[@]}" on a bash 3.2 array
  # that ends up with ZERO elements is an "unbound variable" error under
  # this script's own `set -u` (line 3) -- fixed in bash 4.4, still broken
  # on 3.2, the exact version this tool targets. Every invocation with no
  # args at all besides the phase (e.g. a bare `sitegraft graft`, or
  # `--help`/`-h`/`--version` with nothing else) hit this immediately: the
  # loop below never appends anything, and the raw re-splat failed with
  # "args[@]: unbound variable" instead of proceeding normally. The length
  # check around the re-splat avoids ever evaluating "${args[@]}" on an
  # empty array, sidestepping the bug entirely rather than relying on one of
  # the more obscure ${args[@]+...} parameter-expansion workarounds -- this
  # codebase avoided arrays altogether before this function for reasons
  # never written down; this bug is presumably exactly why.
  local args=() dry_run=0 arg
  for arg in "$@"; do
    if [ "$arg" = "--dry-run" ]; then dry_run=1; else args+=("$arg"); fi
  done
  if [ "${#args[@]}" -gt 0 ]; then
    set -- "${args[@]}"
  else
    set --
  fi
  [ "$dry_run" -eq 1 ] && export SITEGRAFT_DRY_RUN=1

  local phase="${1:-}"
  [ -n "$phase" ] || { usage; exit 1; }
  shift || true

  # m5: dependencies are checked per phase, not all up front — "sitegraft
  # --help"/"-h" (and, previously, every phase) used to require rsync even
  # though only backup/graft/restore actually invoke it.
  case "$phase" in
    scan)
      require_cmd jq || exit 1
      require_lib profile 1 || exit 1
      require_lib modules 1 || exit 1
      require_lib inventory 1 || exit 1
      modules_discover
      phase_scan "$@"
      ;;
    plan)
      require_cmd jq || exit 1
      require_lib profile 1 || exit 1
      require_lib modules 1 || exit 1
      require_lib inventory 1 || exit 1
      require_lib manifest 2 || exit 1
      require_lib plan 2 || exit 1
      modules_discover
      phase_plan "$@"
      ;;
    backup)
      require_cmd jq || exit 1
      require_cmd rsync || exit 1
      require_cmd gzip || exit 1
      require_cmd shasum || exit 1
      require_lib profile 1 || exit 1
      require_lib inventory 1 || exit 1
      require_lib backup 3 || exit 1
      phase_backup "$@"
      ;;
    graft)
      require_cmd jq || exit 1
      require_cmd rsync || exit 1
      # MINOR-2 (review): graft_integrity_gate and graft_verify_import_
      # completeness (both lib/graft.sh) now invoke `php` for every real
      # graft — a SECURITY control (design doc §6.4 step 4) and issue #53's
      # own completeness gate, not an optional feature. Without this check,
      # a PATH missing php was invisible until the `export` step deep into
      # phase_graft — well AFTER backup, media sync, prune, and attachment
      # import had already mutated B — instead of failing fast, in the
      # first second, the same way a missing jq/rsync already does.
      require_cmd php || exit 1
      require_lib profile 1 || exit 1
      require_lib modules 1 || exit 1
      require_lib inventory 1 || exit 1
      # graft.sh reuses backup.sh's _backup_local_exec_prefix for every local
      # (non-ssh) transfer that touches a wrapped-local site (e.g. DDEV) — see
      # lib/graft.sh's own header comment for why.
      require_lib backup 3 || exit 1
      require_lib graft 4 || exit 1
      modules_discover
      phase_graft "$@"
      ;;
    verify)
      require_cmd jq || exit 1
      # MINOR-2 (review): lib/verify.sh's own content-equality guards
      # (issue #52) also invoke `php` — same reasoning as the `graft` case
      # just above.
      require_cmd php || exit 1
      require_lib profile 1 || exit 1
      require_lib inventory 1 || exit 1
      require_lib backup 3 || exit 1
      require_lib graft 4 || exit 1
      require_lib verify 5 || exit 1
      phase_verify "$@"
      ;;
    restore)
      require_cmd jq || exit 1
      require_cmd rsync || exit 1
      require_cmd gzip || exit 1
      require_lib profile 1 || exit 1
      # inventory.sh for sq(): phase_restore generates a restore.sh of its own
      # for the pre-restore safety snapshot, and every path baked into a
      # generated script goes through sq() (see
      # backup_generate_restore_script's header comment). Without this the
      # snapshot's restore.sh could not be generated at all.
      require_lib inventory 1 || exit 1
      require_lib backup 3 || exit 1
      phase_restore "$@"
      ;;
    -h|--help|help) usage ;;
    --version) echo "sitegraft ${SITEGRAFT_VERSION}" ;;
    *) log_error "unknown phase: ${phase}"; usage; exit 1 ;;
  esac
}

main "$@"
