# Dependencies
node_modules/
**/node_modules/
vendor/

# Build / artifacts
*.zip
dist/

# Env & secrets (never commit)
.env
.env.*
!.env.example

# sitegraft credentials (never commit — one file per profile, chmod 600)
*.creds
profiles/*.creds

# sitegraft profiles (never commit — real hostnames, filesystem paths, site
# URLs and an SSH user, per CLAUDE.md's "no real host/IP/token/client name,
# not even as a realistic-looking example"; see issue #18). example.conf is
# the one profile that holds only placeholders, so it stays tracked. This
# also covers profiles/local.conf and profiles/ddev-test.conf (the latter
# generated by tests/integration/ddev-harness.sh at runtime) — no separate
# entry needed for either.
# The suffix patterns matter as much as the base one: `cp prod.conf
# prod.conf.bak` before an edit, a vim `prod.conf~`, an editor's
# `.prod.conf.swp`, or a merge's `prod.conf.orig` each hold exactly the same
# real hosts and paths as the profile itself.
profiles/*.conf*
profiles/**/*.conf*
!profiles/example.conf

# sitegraft run state (backups, manifests, logs, id-maps — local to the machine)
.sitegraft/
runs/
*.sitegraft-run/

# bats-core test framework (if vendored/submoduled)
tests/bats/
tests/test_helper/bats-support/
tests/test_helper/bats-assert/

# DDEV local sites (integration harness)
.ddev/db_snapshots/
.ddev/*.local/

# OS / editor
.DS_Store
*.log
*.orig
*.rej
*.bak
*~
*.swp
.claude/worktrees/
